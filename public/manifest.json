{
  "manifest_version": 3,
  "name": "Glooks Mail AI Assistant",
  "version": "1.0",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "oauth2": {
    "client_id": "473167517964-l6dfja1f4unke3qkhaurqftnuj7ov170.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  }
}
